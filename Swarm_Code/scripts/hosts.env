# Rig inventory — every address and login in one place.
#
# Sourced by deploy.sh and preflight.sh. Edit this file and nothing else when a
# board is re-imaged, renamed, or handed a different DHCP lease.
#
# Two address families, and the difference matters:
#
#   10.42.0.x     the laptop's shared-ethernet segment. Used for ALL
#                 administration: ssh, scp, apt. The laptop holds 10.42.0.1 and
#                 NATs internet to the boards. These are DHCP and CAN MOVE
#                 between boards — verify with `ip neigh` before trusting one
#                 (see the MAC column below).
#   192.168.50.x  NanoNet, the swarm's own 2.4 GHz network. Static. No route to
#                 the internet. This is what the application traffic uses.

# ── Jetson Nano 1 ─────────────────────────────────────────────────────────
# Hostname admindesktop-desktop. Claims the AP at 30 s, so it is the WORKER on
# a normal cold boot and only becomes master if Nano 2 is absent.
NANO1_SSH="admindesktop@10.42.0.43"
NANO1_MAC="48:b0:2d:f5:dc:3f"
NANO1_NANONET="192.168.50.51"

# ── Jetson Nano 2 ─────────────────────────────────────────────────────────
# Hostname admindesktop1-desktop. Claims the AP at 5 s, so it is the intended
# MASTER, and it is also the swarm's chrony reference clock.
# Note the trailing 1 in the username — it is on the board numbered 2.
NANO2_SSH="admindesktop1@10.42.0.226"
NANO2_MAC="48:b0:2d:c1:71:9f"
NANO2_NANONET="192.168.50.55"

# ── Raspberry Pi 1 ────────────────────────────────────────────────────────
# Hostname raspberrypi. Streams as sensor id pi1.
PI1_SSH="admin@10.42.0.31"
PI1_NANONET="192.168.50.11"
PI1_SENSOR_ID="pi1"

# ── Raspberry Pi 2 ────────────────────────────────────────────────────────
# Hostname pi2, login pi02 (zero-two), sensor id pi2. Three near-identical
# strings and they are NOT interchangeable: only the login carries the zero.
PI2_SSH="pi02@10.42.0.128"
PI2_MAC="b8:27:eb:d2:82:16"
PI2_NANONET="192.168.50.12"
PI2_SENSOR_ID="pi2"

# ── Where the code lives on each device ───────────────────────────────────
# NANO_DIR is fixed by mec_node.py, which resolves the model as the PARENT of
# its own directory. Move it and the model is looked for in the wrong place.
NANO_DIR="~/yolov5/swarm"
PI_DIR="~/pi_sensor"

# ── The swarm network ─────────────────────────────────────────────────────
#
# ⚠  THIS IS A REAL CREDENTIAL AND IT IS COMMITTED TO THE REPOSITORY.
#
# It is written out rather than left as a placeholder because the build guide is
# meant to be followed without guessing, and a rig whose password is "YourPassword123"
# in the docs and something else in reality is how the two drift apart.
#
# BEFORE MAKING THIS REPOSITORY PUBLIC, either change the rig's PSK or scrub it:
#
#     grep -rln nanonet123 . | xargs sed -i 's/nanonet123/CHANGEME/g'
#
# Then set the new one on every device (Nanos: NanoNet-ap and NanoNet-client;
# Pis and laptop: NanoNet):
#
#     sudo nmcli connection modify <profile> wifi-sec.psk "<new>"
#
# The network is WPA2-PSK with no join authentication, so anyone holding this can
# associate and — if they also run mec_node.py — be handed frames as a worker.
SSID="NanoNet"
PSK="nanonet123"
MASTER_ADDR="192.168.50.1"
GCS_ADDR="192.168.50.23"
